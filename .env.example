# SlotFit configuration template.
#
# Copy to .env at the repo root and fill in the values:
#   cp .env.example .env
#
# .env is the canonical config file for the whole repo. The FastAPI app,
# alembic, and everything under backend/scripts read it through
# app.core.config, which resolves it by absolute path from the repo root, so
# commands work from any working directory. hevy/pull_hevy.py reads it too.
#
# Values that must reach the browser do NOT belong here. Vite only exposes
# VITE_-prefixed variables and reads web/.env, which is kept separate on
# purpose so a server-side secret cannot be bundled into client JS by mistake.

# Database

# Async driver is required (postgresql+asyncpg, not plain postgresql).
# Local docker-compose default credentials are postgres / slotfit.
DATABASE_URL=postgresql+asyncpg://postgres:slotfit@localhost:5432/slotfit

# AI provider

# Which provider backs exercise recommendations: claude | gemini | ollama.
# With no key set, recommendations fall back to the deterministic rule-based
# provider - the app still runs.
AI_PROVIDER=claude

# Anthropic key for the Claude recommendation service.
# Get one at https://console.anthropic.com/settings/keys
# Required when AI_PROVIDER=claude. Starts with sk-ant-.
ANTHROPIC_API_KEY=

# Google Gemini key. Required only when AI_PROVIDER=gemini.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude model for recommendations. Configurable so a retired model is an env
# change rather than a code change: the id used to be hardcoded, and when
# claude-3-sonnet-20240229 was retired every request 404'd for months and fell
# through to the rule-based provider with nothing surfacing it.
# Model ids carry no date suffix. Leave unset to use the default below.
AI_MODEL=claude-opus-5

# Output cap for a recommendation payload. Too low truncates the response
# mid-object, which is indistinguishable from a parse failure.
AI_MAX_TOKENS=16000

# API

API_V1_PREFIX=/api/v1
DEBUG=True

# Comma-separated origins allowed by CORS. 3000 is the Vite dev server,
# 5173 is the Vite default if the configured port is taken.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Integrations

# Hevy workout export, used by hevy/pull_hevy.py.
# Get a key at https://hevy.com/settings?developer - requires Hevy Pro.
# Optional: only the Hevy puller reads it, the app does not.
HEVY_API_KEY=

# Not set here

# E2E_DATABASE_URL is deliberately NOT read from this file. The Playwright
# suite requires it to be exported in the shell so a run can never silently
# target the dev database (see web/playwright.config.ts). Set it per shell:
#
#   PowerShell:
#     $env:E2E_DATABASE_URL = (Select-String -Path .env.e2e -Pattern '^DATABASE_URL=(.+)$').Matches[0].Groups[1].Value
#
# The e2e database's own settings live in .env.e2e at the repo root, which
# mirrors this file but points at the slotfit_e2e database and leaves the AI
# keys blank so recommendations exercise the rule-based fallback.
#
# USE_PROD_DB=true makes the pytest suite run against DATABASE_URL instead of
# its own test database (see backend/tests/conftest.py). Export it per shell
# when you actually want that; it is not a normal setting.

# VITE_API_URL belongs in web/.env, not here. It defaults to
# http://localhost:8000/api/v1 and only needs setting if the backend moves.
